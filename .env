# Ollama Configuration
DID_OLLAMA_BASE_URL=http://localhost:11434
DID_OLLAMA_MODEL=llama2:7b
DID_OLLAMA_JUDGE_MODEL=llama3.1:8b

# Framework Safety Thresholds
DID_T_SAFE=0.35
DID_NLI_CONFIDENCE_THRESHOLD=0.65
DID_NLI_ACCEPT_THRESHOLD=0.15
DID_NLI_REJECT_THRESHOLD=-0.15
DID_SEARCH_BACKEND=duckduckgo

# Server Bindings
DID_HOST=0.0.0.0
DID_PORT=8000
# Layer 1: sampled semantic entropy triage (Farquhar et al., 2024)
DID_TRIAGE_MODE=semantic_entropy
DID_SE_NUM_SAMPLES=4
DID_SE_SAMPLE_TEMPERATURE=0.7

# Layer 3: plan-guided execution mode (single_pass | per_step)
DID_HALLUCLEAN_EXECUTOR_MODE=single_pass
DID_T_SAFE_REASONING=0.0
